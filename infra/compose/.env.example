# Reference only. Do not copy by hand: run `pnpm qos init`, which writes infra/compose/.env
# (gitignored) with randomly generated secrets.
POSTGRES_USER=qos
POSTGRES_PASSWORD=<generated: 48 hex characters>
POSTGRES_DB=qualityos
POSTGRES_PORT=55432
FILE_URL_SECRET=<generated: 64 hex characters>
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info

# For running the apps on the host against `pnpm dev:db`, `qos init` also prints the matching
# DATABASE_URL shape: postgres://qos:<POSTGRES_PASSWORD>@127.0.0.1:55432/qualityos
