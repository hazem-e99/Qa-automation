# Copy to infra/compose/.env (gitignored) and set your own values.
# `qos init` (T-P1-13) will generate this file with random secrets; until then, edit by hand.
POSTGRES_USER=qos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=qualityos
POSTGRES_PORT=5432

# Used by the apps when run on the host (pnpm --filter @qos/api start):
# DATABASE_URL=postgres://qos:change-me-local-only@127.0.0.1:5432/qualityos
