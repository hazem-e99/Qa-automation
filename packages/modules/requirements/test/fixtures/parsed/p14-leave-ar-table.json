 "blocks": [
  {
   "id": "b1",
   "type": "paragraph",
   "text": "بوابة الموارد البشرية — متطلبات طلب الإجازة",
   "locator": {
    "page": 1,
    "line": 1
   },
   "language": "ar"
  },
  {
   "id": "b2",
   "type": "paragraph",
   "text": ".1 مقدمة",
   "locator": {
    "page": 1,
    "line": 2
   },
   "language": "ar"
  },
  {
   "id": "b3",
   "type": "paragraph",
   "text": "تحدد إدارة الموارد البشرية سياسات الإجازات وقد تتغير سنويا.ً",
   "locator": {
    "page": 1,
    "line": 3
   },
   "language": "ar"
  },
  {
   "id": "b4",
   "type": "paragraph",
   "text": "الربط مع نظام الرواتب موصوف في وثيقة منفصلة.",
   "locator": {
    "page": 1,
    "line": 4
   },
   "language": "ar"
  },
  {
   "id": "b5",
   "type": "paragraph",
   "text": ".2 المتطلبات الوظيفية",
   "locator": {
    "page": 1,
    "line": 5
   },
   "language": "ar"
  },
  {
   "id": "b6",
   "type": "paragraph",
   "text": "المعرف المتطلب معايير القبول الأولوية",
   "locator": {
    "page": 1,
    "line": 6
   },
   "language": "ar"
  },
  {
   "id": "b7",
   "type": "paragraph",
   "text": "يعرض الطلب عدد أيام العمل المطلوبة. متوسطة",
   "locator": {
    "page": 1,
    "line": 7
   },
   "language": "ar"
  },
  {
   "id": "b8",
   "type": "paragraph",
   "text": "يجب أن يتيح النظام للموظف تقديم طلب إجازة سنوية بتاريخ بداية",
   "locator": {
    "page": 1,
    "line": 8
   },
   "language": "ar"
  },
  {
   "id": "b9",
   "type": "paragraph",
   "text": "ونهاية.",
   "locator": {
    "page": 1,
    "line": 9
   },
   "language": "ar"
  },
  {
   "id": "b10",
   "type": "paragraph",
   "text": "FR-1",
   "locator": {
    "page": 1,
    "line": 10
   },
   "language": "en"
  },
  {
   "id": "b11",
   "type": "paragraph",
   "text": "-2FR يجب أن يمنع النظام طلب إجازة يتجاوز الرصيد المتبقي. طلب 6 أيام برصيد 5 أيام يُظهر خطأ. منخفضة",
   "locator": {
    "page": 1,
    "line": 11
   },
   "language": "ar"
  },
  {
   "id": "b12",
   "type": "paragraph",
   "text": "-3FR يجب أن يُخطر النظام المدير المباشر عند تقديم الطلب. يتلقى المدير إشعاراً داخل النظام ورسالة بريد. عالية",
   "locator": {
    "page": 1,
    "line": 12
   },
   "language": "ar"
  },
  {
   "id": "b13",
   "type": "paragraph",
   "text": "-4FR يجب على المدير الموافقة على الطلب أو رفضه خالل 3 أيام عمل. بعد 3 أيام عمل يُصعَّد الطلب إلى الموارد البشرية. متوسطة",
   "locator": {
    "page": 1,
    "line": 13
   },
   "language": "ar"
  },
  {
   "id": "b14",
   "type": "paragraph",
   "text": "-5FR يجب أن يستثني النظام العطالت الرسمية من أيام الإجازة المحتسبة. الطلب الذي يشمل عطلة رسمية يُحتسب بيوم أقل. منخفضة",
   "locator": {
    "page": 1,
    "line": 14
   },
   "language": "ar"
  }
 ]
}