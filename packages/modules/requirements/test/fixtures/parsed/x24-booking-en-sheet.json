   "text": "High",
   "locator": {
    "sheet": "Requirements",
    "row": 4,
    "col": 5
   },
   "language": "en"
  },
  {
   "id": "b21",
   "type": "table_cell",
   "text": "Hotel Booking",
   "locator": {
