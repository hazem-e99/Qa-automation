   "locator": {
    "sheet": "Requirements",
    "row": 3,
    "col": 5
   },
   "language": "en"
  },
  {
   "id": "b16",
   "type": "table_cell",
   "text": "Hotel Booking",
   "locator": {
    "sheet": "Requirements",
    "row": 4,
    "col": 1
