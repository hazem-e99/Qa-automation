    "row": 3,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b12",
   "type": "table_cell",
   "text": "FR-2",
   "locator": {
    "sheet": "Requirements",
    "row": 3,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b13",
   "type": "table_cell",
   "text": "The system shall not allow a check-out date earlier than or equal to the check-in date.",
   "locator": {
    "sheet": "Requirements",
    "row": 3,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b14",
   "type": "table_cell",
   "text": "Same-day check-out shows a validation error.",
   "locator": {
    "sheet": "Requirements",
    "row": 3,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b15",
