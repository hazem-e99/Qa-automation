    "row": 5,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b23",
   "type": "table_cell",
   "text": "The system must hold a reservation for 15 minutes while payment is in progress.",
   "locator": {
    "sheet": "Requirements",
    "row": 5,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b24",
   "type": "table_cell",
   "text": "After 15 minutes without payment the hold is released.",
   "locator": {
    "sheet": "Requirements",
    "row": 5,
    "col": 4
   },
   "language": "en"
  },
  {
