    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b8",
   "type": "table_cell",
   "text": "The system shall show available rooms for the selected dates and number of guests.",
   "locator": {
    "sheet": "Requirements",
    "row": 2,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b9",
   "type": "table_cell",
   "text": "Rooms with no availability on any selected night are hidden.",
   "locator": {
    "sheet": "Requirements",
    "row": 2,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b10",
