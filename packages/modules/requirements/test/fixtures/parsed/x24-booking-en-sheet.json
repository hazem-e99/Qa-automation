    "row": 4,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b18",
   "type": "table_cell",
   "text": "The system shall allow free cancellation up to 48 hours before check-in.",
   "locator": {
    "sheet": "Requirements",
    "row": 4,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b19",
   "type": "table_cell",
   "text": "Cancellation 49 hours before is free.\nCancellation 47 hours before charges one night.",
   "locator": {
    "sheet": "Requirements",
    "row": 4,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b20",
