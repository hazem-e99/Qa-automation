 "blocks": [
  {
   "id": "b1",
   "type": "heading",
   "text": "المتجر الإلكتروني — متطلبات إتمام الشراء",
   "locator": {
    "sectionPath": [
     "المتجر الإلكتروني — متطلبات إتمام الشراء"
    ]
   },
   "language": "ar",
   "level": 1
  },
  {
   "id": "b2",
   "type": "heading",
   "text": "1. مقدمة",
   "locator": {
    "sectionPath": [
     "1. مقدمة"
    ]
   },
   "language": "ar",
   "level": 1
  },
  {
   "id": "b3",
   "type": "paragraph",
   "text": "يصف هذا القسم مسار إتمام الشراء في المتجر الإلكتروني للعملاء المسجلين والزوار.",
   "locator": {
    "sectionPath": [
     "1. مقدمة"
    ],
    "paragraph": 1
   },
   "language": "ar"
  },
  {
   "id": "b4",
   "type": "paragraph",
   "text": "تتم معالجة الدفع عبر بوابة خارجية وهي خارج نطاق هذه الوثيقة.",
   "locator": {
    "sectionPath": [
     "1. مقدمة"
    ],
    "paragraph": 2
   },
   "language": "ar"
  },
  {
   "id": "b5",
   "type": "heading",
   "text": "2. المتطلبات الوظيفية",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ]
   },
   "language": "ar",
   "level": 1
  },
  {
   "id": "b6",
   "type": "paragraph",
   "text": "REQ-1: يجب أن يتيح النظام للعميل مراجعة سلة المشتريات قبل الدفع.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 3
   },
   "language": "ar"
  },
  {
   "id": "b7",
   "type": "paragraph",
   "text": "معايير القبول:",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 4
   },
   "language": "ar"
  },
  {
   "id": "b8",
   "type": "list_item",
   "text": "تعرض صفحة السلة اسم المنتج والكمية وسعر الوحدة والإجمالي لكل بند.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 5
   },
   "language": "ar"
  },
  {
   "id": "b9",
   "type": "list_item",
   "text": "يمكن للعميل تعديل الكمية أو حذف المنتج.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 6
   },
   "language": "ar"
  },
  {
   "id": "b10",
   "type": "paragraph",
   "text": "REQ-2: يجب أن يحسب النظام إجمالي الطلب شاملاً ضريبة القيمة المضافة بنسبة 14 بالمئة.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 7
   },
   "language": "ar"
  },
  {
   "id": "b11",
   "type": "paragraph",
   "text": "معايير القبول:",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 8
   },
   "language": "ar"
  },
  {
   "id": "b12",
   "type": "list_item",
   "text": "الإجمالي يساوي مجموع البنود مضافاً إليه 14% ضريبة مع التقريب لرقمين عشريين.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 9
   },
   "language": "ar"
  },
  {
   "id": "b13",
   "type": "paragraph",
   "text": "REQ-3: يجب أن يرفض النظام رمز الخصم منتهي الصلاحية.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 10
   },
   "language": "ar"
  },
  {
   "id": "b14",
   "type": "paragraph",
   "text": "معايير القبول:",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 11
   },
   "language": "ar"
  },
  {
   "id": "b15",
   "type": "list_item",
   "text": "تظهر رسالة «انتهت صلاحية الرمز» ولا يتغير الإجمالي.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 12
   },
   "language": "ar"
  },
  {
   "id": "b16",
   "type": "paragraph",
   "text": "REQ-4: ينبغي أن يدعم النظام الشراء كزائر دون إنشاء حساب.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 13
   },
   "language": "ar"
  },
  {
   "id": "b17",
   "type": "paragraph",
   "text": "معايير القبول:",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 14
   },
   "language": "ar"
  },
  {
   "id": "b18",
   "type": "list_item",
   "text": "يتطلب الشراء كزائر البريد الإلكتروني ورقم الهاتف وعنوان التوصيل فقط.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 15
   },
   "language": "ar"
  },
  {
   "id": "b19",
   "type": "paragraph",
   "text": "REQ-5: يجب أن يرسل النظام رسالة تأكيد الطلب خلال 5 دقائق من نجاح الدفع.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 16
   },
   "language": "ar"
  },
  {
   "id": "b20",
   "type": "paragraph",
   "text": "معايير القبول:",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 17
   },
   "language": "ar"
  },
  {
   "id": "b21",
   "type": "list_item",
   "text": "تحتوي الرسالة على رقم الطلب والمنتجات والإجمالي.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 18
   },
   "language": "ar"
  },
  {
   "id": "b22",
   "type": "paragraph",
   "text": "REQ-6: يجب ألا يسمح النظام بطلب كمية أكبر من 10 لنفس المنتج.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 19
   },
   "language": "ar"
  },
  {
   "id": "b23",
   "type": "paragraph",
   "text": "معايير القبول:",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 20
   },
   "language": "ar"
  },
  {
   "id": "b24",
   "type": "list_item",
   "text": "الكمية 11 تُظهر خطأ تحقق.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 21
   },
   "language": "ar"
  },
  {
   "id": "b25",
   "type": "list_item",
   "text": "الكمية 10 مقبولة.",
   "locator": {
    "sectionPath": [
     "2. المتطلبات الوظيفية"
    ],
    "paragraph": 22
   },
   "language": "ar"
  }
 ]
