  {
   "id": "b1",
   "type": "heading",
   "text": "Customer Portal — Authentication Requirements",
   "locator": {
    "sectionPath": [
     "Customer Portal — Authentication Requirements"
    ]
   },
   "language": "en",
   "level": 1
  },
  {
   "id": "b2",
   "type": "heading",
   "text": "1. Introduction",
   "locator": {
    "sectionPath": [
     "1. Introduction"
    ]
   },
   "language": "en",
   "level": 1
  },
  {
   "id": "b3",
   "type": "paragraph",
   "text": "Authentication applies to the web portal and the mobile web view.",
   "locator": {
    "sectionPath": [
     "1. Introduction"
    ],
    "paragraph": 1
   },
   "language": "en"
  },
  {
   "id": "b4",
   "type": "paragraph",
   "text": "Single sign-on is planned for a later release.",
   "locator": {
    "sectionPath": [
     "1. Introduction"
    ],
    "paragraph": 2
   },
   "language": "en"
  },
  {
   "id": "b5",
   "type": "heading",
   "text": "2. Functional requirements",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ]
   },
   "language": "en",
   "level": 1
  },
  {
   "id": "b6",
   "type": "table_cell",
   "text": "ID",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 1,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b7",
   "type": "table_cell",
   "text": "Requirement",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 1,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b8",
   "type": "table_cell",
   "text": "Acceptance Criteria",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 1,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b9",
   "type": "table_cell",
   "text": "Priority",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 1,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b10",
   "type": "table_cell",
   "text": "FR-1",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 2,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b11",
   "type": "table_cell",
   "text": "The system shall require a password of at least 8 characters.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 2,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b12",
   "type": "table_cell",
   "text": "A 7-character password is rejected.\nAn 8-character password is accepted.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 2,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b13",
   "type": "table_cell",
   "text": "Medium",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 2,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b14",
   "type": "table_cell",
   "text": "FR-2",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 3,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b15",
   "type": "table_cell",
   "text": "The system shall lock the account after 5 consecutive failed login attempts.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 3,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b16",
   "type": "table_cell",
   "text": "The 6th attempt shows 'Account locked'.\nThe lock lasts 15 minutes.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 3,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b17",
   "type": "table_cell",
   "text": "Low",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 3,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b18",
   "type": "table_cell",
   "text": "FR-3",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 4,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b19",
   "type": "table_cell",
   "text": "The system shall allow users to reset their password via an emailed link valid for 30 minutes.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 4,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b20",
   "type": "table_cell",
   "text": "An expired link shows 'Link expired'.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 4,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b21",
   "type": "table_cell",
   "text": "High",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 4,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b22",
   "type": "table_cell",
   "text": "FR-4",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 5,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b23",
   "type": "table_cell",
   "text": "The system should offer optional two-factor authentication using a one-time code.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 5,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b24",
   "type": "table_cell",
   "text": "Enabling 2FA requires confirming one valid code.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 5,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b25",
   "type": "table_cell",
   "text": "Medium",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 5,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b26",
   "type": "table_cell",
   "text": "FR-5",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 6,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b27",
   "type": "table_cell",
   "text": "The system must log out an idle session after 20 minutes.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 6,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b28",
   "type": "table_cell",
   "text": "After 20 minutes of inactivity the next action redirects to login.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 6,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b29",
   "type": "table_cell",
   "text": "Low",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 6,
    "col": 4
   },
   "language": "en"
  },
  {
   "id": "b30",
   "type": "table_cell",
   "text": "FR-6",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 7,
    "col": 1
   },
   "language": "en"
  },
  {
   "id": "b31",
   "type": "table_cell",
   "text": "The system shall display a generic error message for invalid credentials.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 7,
    "col": 2
   },
   "language": "en"
  },
  {
   "id": "b32",
   "type": "table_cell",
   "text": "The message does not reveal whether the email exists.",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 7,
    "col": 3
   },
   "language": "en"
  },
  {
   "id": "b33",
   "type": "table_cell",
   "text": "High",
   "locator": {
    "sectionPath": [
     "2. Functional requirements"
    ],
    "table": 1,
    "row": 7,
    "col": 4
   },
   "language": "en"
  }
 ]
}