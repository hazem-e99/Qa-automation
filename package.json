{
  "name": "qualityos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && pnpm run lint:deps",
    "lint:deps": "depcruise --config packages/config/dependency-cruiser.cjs apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "knip": "knip",
    "db:generate": "pnpm --filter @qos/db run generate",
    "db:migrate": "pnpm --filter @qos/db run migrate",
    "dev:db": "docker compose -f infra/compose/docker-compose.yml --profile db up -d --wait"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "~18.7.2",
    "eslint": "^10.14.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "turbo": "~2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~5.1.0"
  }
}
